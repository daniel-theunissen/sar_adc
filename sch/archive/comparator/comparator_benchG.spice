Rsp sp inp {rsrc}
Rsn sn inn {rsrc}
Cinp inp 0 {cin}
Cinn inn 0 {cin}
Xc VDD 0 inp inn phi1 phi2 outp outn comparator
Cop outp 0 {cout}
Con outn 0 {cout}

* SR latch on the (return-to-zero) outputs: vlat = decision, held while Q and Qb are both 0
.subckt cmp_nor2 a b y VDD GND
XP1 n1 a VDD VDD sky130_fd_pr__pfet_01v8 L=0.15 W=2
XP2 y b n1 VDD sky130_fd_pr__pfet_01v8 L=0.15 W=2
XN1 y a GND GND sky130_fd_pr__nfet_01v8 L=0.15 W=1
XN2 y b GND GND sky130_fd_pr__nfet_01v8 L=0.15 W=1
.ends cmp_nor2
Xs1 outn vlatb vlat VDD 0 cmp_nor2
Xs2 outp vlat vlatb VDD 0 cmp_nor2
.nodeset v(vlat)=0 v(vlatb)=1.8

.lib /foss/pdks/sky130A/libs.tech/combined/sky130.lib.spice tt
.temp 27
.options reltol=1e-5
.save all
.save i(vdd)

.control
  set wr_singlescale
  tran 0.1n 25000n
  let vsp_ = v(sp)
  let vsn_ = v(sn)
  let vinp = v(inp)
  let vinn = v(inn)
  let voutp = v(outp)
  let voutn = v(outn)
  let idd = -i(Vdd)
  let vp1 = v(phi1)
  let vp2 = v(phi2)
  let vl = v(vlat)
  let vlb = v(vlatb)
  let vna = v(xc.a)
  let vnb = v(xc.b)
  let vtl = v(xc.tail)
  wrdata tran_g.csv vsp_ vsn_ vinp vinn voutp voutn idd vp1 vp2 vl vlb vna vnb vtl
.endc

.end
