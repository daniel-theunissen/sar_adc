  alter Vdc dc = 0

  * 2. static transfer: vd from -(half + 0.05) to +(half + 0.05)
  dc Vdc -0.550 0.550 0.002
  let io1 = i(Vo1)
  let io2 = i(Vo2)
  let vs1 = v(xc.s1)
  let vs2 = v(xc.s2)
  let vg1 = v(xc.g1)
  let vg2 = v(xc.g2)
  let vinp = v(inp)
  let vinn = v(inn)
  let idd = -i(VDD)
  wrdata dc_sweep.csv io1 io2 vs1 vs2 vg1 vg2 vinp vinn idd

  * 3. input common-mode sweeps at three differential inputs
  alter Vdc dc = -0.450
  dc Vcm 0.05 1.45 0.01
  let io1 = i(Vo1)
  let io2 = i(Vo2)
  let vs1 = v(xc.s1)
  let vs2 = v(xc.s2)
  let vg1 = v(xc.g1)
  let vg2 = v(xc.g2)
  let vinp = v(inp)
  let vinn = v(inn)
  let idd = -i(VDD)
  wrdata cm_sweep_lo.csv io1 io2 vs1 vs2 vg1 vg2 vinp vinn idd
  alter Vdc dc = 0
  dc Vcm 0.05 1.45 0.01
  let io1 = i(Vo1)
  let io2 = i(Vo2)
  let vs1 = v(xc.s1)
  let vs2 = v(xc.s2)
  let vg1 = v(xc.g1)
  let vg2 = v(xc.g2)
  let vinp = v(inp)
  let vinn = v(inn)
  let idd = -i(VDD)
  wrdata cm_sweep_mid.csv io1 io2 vs1 vs2 vg1 vg2 vinp vinn idd
  alter Vdc dc = 0.450
  dc Vcm 0.05 1.45 0.01
  let io1 = i(Vo1)
  let io2 = i(Vo2)
  let vs1 = v(xc.s1)
  let vs2 = v(xc.s2)
  let vg1 = v(xc.g1)
  let vg2 = v(xc.g2)
  let vinp = v(inp)
  let vinn = v(inn)
  let idd = -i(VDD)
  wrdata cm_sweep_hi.csv io1 io2 vs1 vs2 vg1 vg2 vinp vinn idd
  alter Vdc dc = 0

  * 4. voltage of the regulated nodes (where do T1 and T2 stay saturated?)
  dc Vref2 0.3 1.8 0.01
  let io1 = i(Vo1)
  let io2 = i(Vo2)
  let vs1 = v(xc.s1)
  let vs2 = v(xc.s2)
  let vg1 = v(xc.g1)
  let vg2 = v(xc.g2)
  let vinp = v(inp)
  let vinn = v(inn)
  let idd = -i(VDD)
  wrdata out_sweep.csv io1 io2 vs1 vs2 vg1 vg2 vinp vinn idd
  alter Vref2 dc = 1.55

  * 5. transient with the coherent sine (-0.5 dBFS, 113.28 kHz, 29 periods in 256 us)
  alter Vmode dc = 0
  option reltol=1e-4
  tran 5n 256.0u
  let vdiff = v(inp) - v(inn)
  let io1 = i(Vo1)
  let io2 = i(Vo2)
  wrdata tran_sine.csv vdiff io1 io2

  * 6. transient with large steps (settling): 0 -> +0.8 half -> -0.8 half -> 0
  alter Vmode dc = 1
  tran 0.1n 2.6u
  let vdiff = v(inp) - v(inn)
  let io1 = i(Vo1)
  let io2 = i(Vo2)
  let vg1 = v(xc.g1)
  let vs1 = v(xc.s1)
  wrdata tran_step.csv vdiff io1 io2 vg1 vs1
.endc
.end
