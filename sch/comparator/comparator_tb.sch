C {code_shown.sym} 60 140 0 0 {name=SPICE only_toplevel=false value="
.param rsrc=35k cin=95f cout=10f
.include comparator_tb.save
.nodeset v(vlat)=0 v(vlatb)=1.8
.options reltol=1e-5
.save all
.option savecurrents

.control
  op
  write @schname\\\\.raw
  set wr_singlescale
  tran 0.1n 25000n
  let vsp_ = v(sp)
  let vsn_ = v(sn)
  let vinp = v(inp)
  let vinn = v(inn)
  let voutp = v(outp)
  let voutn = v(outn)
  let idd = -i(Vdd)
  let vp1 = v(phi1)
  let vp2 = v(phi2)
  let vl = v(vlat)
  let vlb = v(vlatb)
  let vna = v(xc.a)
  let vnb = v(xc.b)
  let vtl = v(xc.tail)
  wrdata tran_g.csv vsp_ vsn_ vinp vinn voutp voutn idd vp1 vp2 vl vlb vna vnb vtl
  write comparator_tb_tran.raw
.endc
"

}
